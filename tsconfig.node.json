{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "resources/kanban/lib/**/*.ts",
    "src/renderer/src/stores/chat.ts",
    "src/renderer/src/stores/sessions.ts",
    "src/renderer/src/stores/terminal.ts",
    "src/renderer/src/stores/panels-prefs.ts",
    "src/renderer/src/stores/git.ts",
    "src/renderer/src/stores/gitlog.ts",
    "src/renderer/src/stores/files.ts",
    "src/renderer/src/stores/kanban.ts",
    "src/renderer/src/stores/tabs.ts",
    "src/renderer/src/lib/background-watchdog.ts",
    "src/renderer/src/lib/git-file-class.ts",
    "src/renderer/src/lib/kanban-attention.ts",
    "src/renderer/src/lib/kanban-card-dot.ts",
    "src/renderer/src/lib/duration.ts",
    "src/renderer/src/lib/virtual-feed.ts",
    "src/renderer/src/lib/fuzzy.ts",
    "src/renderer/src/views/git/git-log-model.ts",
    "src/renderer/src/views/terminal/term-registry.ts",
    "src/renderer/src/global.d.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/worktree-cleanup.test.tsx"]
}
